From 7fbc40c594fef87f845dcb70242d061b396a7107 Mon Sep 17 00:00:00 2001
From: Harshkamdar67 <harshkamdar67@gmail.com>
Date: Sat, 21 Nov 2026 11:28:18 +0530
Subject: [PATCH 03/32] inkling2: compute the norm clip with l2_norm

x*min(1, t/|x|) == t*x/max(|x|, t), one op instead of seven, applied three times per layer visit.
---
 src/models/inkling2.cpp | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index e035d1a7b..eab656bb7 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -166,12 +166,8 @@ ggml_tensor * llama_model_inkling2::graph::clip(ggml_tensor * cur, ggml_tensor *
         cur = ggml_mul(ctx0, cur, scale);
     }
 
-    ggml_tensor * norm = ggml_sqrt(ctx0, ggml_sum_rows(ctx0, ggml_sqr(ctx0, cur)));
-    norm = ggml_scale_bias(ctx0, norm, 1.0f, 1e-6f);
-
-    ggml_tensor * factor = ggml_div(ctx0, ggml_fill(ctx0, norm, threshold), norm);
-
-    return ggml_mul(ctx0, cur, ggml_clamp(ctx0, factor, 0.0f, 1.0f));
+    // x*min(1, t/|x|) == t*x/max(|x|, t), which l2_norm computes in one op instead of seven
+    return ggml_scale(ctx0, ggml_l2_norm(ctx0, cur, threshold), threshold);
 }
 
 // attention over the depth: mix the earlier block outputs and cur with learned queries
