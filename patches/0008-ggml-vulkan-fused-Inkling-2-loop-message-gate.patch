+// ggml_inkling_loop_gate
+
+struct ggml_tensor * ggml_inkling_loop_gate(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * cur,
+        struct ggml_tensor  * msg,
+        struct ggml_tensor  * down,
+        struct ggml_tensor  * gain,
+        struct ggml_tensor  * forget,
+        float                 eps) {
+    const int64_t n_embd = cur->ne[0];
+    const int64_t rank   = down->ne[1];
+
+    GGML_ASSERT(cur->type == GGML_TYPE_F32 && msg->type == GGML_TYPE_F32);
+    GGML_ASSERT(down->type == GGML_TYPE_F32 && gain->type == GGML_TYPE_F32 && forget->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(cur, msg));
+    GGML_ASSERT(cur->ne[2] == 1 && cur->ne[3] == 1);
+    GGML_ASSERT(cur->nb[0] == sizeof(float) && msg->nb[0] == sizeof(float));
+    GGML_ASSERT(down->ne[0] == 2*n_embd);
+    GGML_ASSERT(gain->ne[0] == rank && gain->ne[1] == n_embd);
+    GGML_ASSERT(ggml_are_same_shape(gain, forget));
+    GGML_ASSERT(ggml_is_contiguous(down) && ggml_is_contiguous(gain) && ggml_is_contiguous(forget));
+
+    // 2*rank rows of scratch after the result in each column, for backends that split the op in two passes
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd + 2*rank, cur->ne[1]);
+
+    ggml_set_op_params_f32(result, 0, eps);
+
+    result->op     = GGML_OP_INKLING_LOOP_GATE;
+    result->src[0] = cur;
+    result->src[1] = msg;
+    result->src[2] = down;
+    result->src[3] = gain;
+    result->src[4] = forget;
+
+    return ggml_view_2d(ctx, result, n_embd, cur->ne[1], result->nb[1], 0);
+}
