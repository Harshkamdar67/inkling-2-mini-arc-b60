     const ggml_tensor * bias    = dst->src[1];
@@ -13930,6 +13972,10 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
     case GGML_OP_INKLING_REL_MASK:
         ggml_vk_inkling_rel_mask(ctx, compute_ctx, node);
 
+        break;
+    case GGML_OP_INKLING_MIX:
+        ggml_vk_inkling_mix(ctx, compute_ctx, node);
+
         break;
     case GGML_OP_MEAN:
         ggml_vk_mean(ctx, compute_ctx, src0, node);
@@ -17210,6 +17256,10 @@ static bool ggml_backend_vk_device_supports_op(ggml_backend_dev_t dev, const ggm
                 }
                 return false;
             }
+        case GGML_OP_INKLING_MIX:
+            // up to 8 blocks and 4 queries, as the shader unrolls them
+            return device->subgroup_arithmetic && device->subgroup_require_full_support &&
+                   ggml_get_op_params_i32(op, 0) <= 8 && op->src[0]->ne[1] <= 4;
         case GGML_OP_INKLING_REL_MASK:
             // F16 mask in and out (the flash attention case); the bias row lives in shared memory
             return op->type == GGML_TYPE_F16 && op->src[4]->type == GGML_TYPE_F16 && op->src[1]->ne[1] <= 4096 && op->src[0]->ne[0] <= 64;
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/inkling_mix.comp b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_mix.comp
new file mode 100644
index 000000000..6c08510bd
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_mix.comp
@@ -0,0 +1,149 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+// Inkling 2 attention over the depth, one workgroup per token:
+//   z_i = rms_norm(state_i), w[q, i] = softmax_i(query_q . z_i / sqrt(n_embd)), out_q = sum_i w[q, i] z_i
+// states: the blocks (bindings 2..9) then cur (binding 1).
+
+layout(constant_id = 0) const uint BLOCK_SIZE = 256;
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+const uint MAX_STATES = 9;
+const uint MAX_QUERY  = 4;
+
+layout(push_constant) uniform parameter
+{
+    uint n_embd;
+    uint n_query;
+    uint n_states;
+    uint nbq1;     // query column stride, elements
+    uint nbd1;     // dst strides, elements
+    uint nbd2;
+    uint q_offset;
+    uint d_offset;
+    uint nbs1[MAX_STATES];      // row stride of each state, elements
+    uint s_offset[MAX_STATES];
+};
+
+layout(binding = 0)  readonly buffer Q  { float data_q[]; };
+layout(binding = 1)  readonly buffer S0 { float data_s0[]; };
+layout(binding = 2)  readonly buffer S1 { float data_s1[]; };
+layout(binding = 3)  readonly buffer S2 { float data_s2[]; };
+layout(binding = 4)  readonly buffer S3 { float data_s3[]; };
+layout(binding = 5)  readonly buffer S4 { float data_s4[]; };
+layout(binding = 6)  readonly buffer S5 { float data_s5[]; };
+layout(binding = 7)  readonly buffer S6 { float data_s6[]; };
+layout(binding = 8)  readonly buffer S7 { float data_s7[]; };
+layout(binding = 9)  readonly buffer S8 { float data_s8[]; };
+layout(binding = 10) writeonly buffer D { float data_d[]; };
+
+// state i in host order: blocks 0..n_states-2 are bindings 2.., cur (the last state) is binding 1
+float load_state(uint i, uint t, uint e) {
+    const uint idx = s_offset[i] + t*nbs1[i] + e;
+    if (i == n_states - 1) return data_s0[idx];
+    switch (i) {
+        case 0: return data_s1[idx];
+        case 1: return data_s2[idx];
+        case 2: return data_s3[idx];
+        case 3: return data_s4[idx];
+        case 4: return data_s5[idx];
+        case 5: return data_s6[idx];
+        case 6: return data_s7[idx];
+        default: return data_s8[idx];
+    }
+}
+
+const uint N_ACC = MAX_STATES*(1 + MAX_QUERY);
+
+shared float red[N_ACC][32];
+shared float tot[N_ACC];
+shared float wgt[MAX_QUERY][MAX_STATES];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint t   = gl_WorkGroupID.x;
+
+    // acc[i] = sum of squares of state i, acc[n_states*(1 + q) + i] = query_q . state_i
+    float acc[N_ACC];
+    [[unroll]] for (uint k = 0; k < N_ACC; ++k) {
+        acc[k] = 0.0;
+    }
+    for (uint e = tid; e < n_embd; e += BLOCK_SIZE) {
+        float qv[MAX_QUERY];
+        [[unroll]] for (uint q = 0; q < MAX_QUERY; ++q) {
+            qv[q] = q < n_query ? data_q[q_offset + q*nbq1 + e] : 0.0;
+        }
+        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+            if (i < n_states) {
+                const float x = load_state(i, t, e);
+                acc[i] += x*x;
+                [[unroll]] for (uint q = 0; q < MAX_QUERY; ++q) {
+                    acc[MAX_STATES*(1 + q) + i] += qv[q]*x;
+                }
+            }
+        }
+    }
+    [[unroll]] for (uint k = 0; k < N_ACC; ++k) {
+        const float v = subgroupAdd(acc[k]);
+        if (subgroupElect()) {
+            red[k][gl_SubgroupID] = v;
+        }
+    }
+    barrier();
+    if (tid < N_ACC) {
+        float s = 0.0;
+        for (uint g = 0; g < gl_NumSubgroups; ++g) {
+            s += red[tid][g];
+        }
+        tot[tid] = s;
+    }
+    barrier();
+
+    if (tid < n_query) {
+        const uint q = tid;
+        const float scale = inversesqrt(float(n_embd));
+        float mx = -1.0/0.0;
+        float sc[MAX_STATES];
+        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+            if (i < n_states) {
+                const float rinv = inversesqrt(tot[i]/float(n_embd) + 1e-6);
+                sc[i] = tot[MAX_STATES*(1 + q) + i]*rinv*scale;
+                mx = max(mx, sc[i]);
+            }
+        }
+        float sum = 0.0;
+        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+            if (i < n_states) {
+                sc[i] = exp(sc[i] - mx);
+                sum += sc[i];
+            }
+        }
+        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+            if (i < n_states) {
+                // fold the state's norm into its weight
+                wgt[q][i] = sc[i]/sum*inversesqrt(tot[i]/float(n_embd) + 1e-6);
+            }
+        }
+    }
+    barrier();
+
+    for (uint e = tid; e < n_embd; e += BLOCK_SIZE) {
+        float x[MAX_STATES];
+        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+            x[i] = i < n_states ? load_state(i, t, e) : 0.0;
+        }
+        for (uint q = 0; q < n_query; ++q) {
+            float o = 0.0;
+            [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
+                if (i < n_states) {
+                    o += wgt[q][i]*x[i];
+                }
+            }
+            data_d[d_offset + q*nbd1 + t*nbd2 + e] = o;
+        }
+    }
+}
