From 80de70bc5838c4149f3cfd0ffc71f284a836bc71 Mon Sep 17 00:00:00 2001
From: Harshkamdar67 <harshkamdar67@gmail.com>
Date: Sun, 22 Nov 2026 00:08:43 +0530
Subject: [PATCH 14/32] vulkan: run the Inkling 2 depth attention in two passes
 over 256-element slices

One workgroup per token left a decode step with one or two workgroups. Pass 0 writes each
slice's sums of squares and query products to scratch after the result, pass 1 adds them,
takes the softmax and writes its slice; the CPU reference fills the same scratch. Used for
single tokens again. B60: decode 37.5 -> 38.8, two-token steps 60.1 -> 63.9, four 86.4 -> 90.3;
pp512 1212 -> 1185.
---
 ggml/include/ggml.h                           |  1 +
 ggml/src/ggml-cpu/ops.cpp                     | 53 ++++++++----
 .../ggml-vulkan/ggml-vulkan-push-constants.h  |  2 +
 ggml/src/ggml-vulkan/ggml-vulkan-types.h      |  2 +-
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          | 37 +++++---
 .../vulkan-shaders/inkling_mix.comp           | 85 ++++++++++---------
 ggml/src/ggml.c                               |  7 +-
 src/models/inkling2.cpp                       | 11 +--
 8 files changed, 120 insertions(+), 78 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 3b3f17337..ce1d4944f 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2508,6 +2508,7 @@ extern "C" {
     // Inkling 2 attention over the depth: states z = rms_norm(blocks..., cur) (no weight, eps 1e-6),
     //   result[:, q, t] = sum_i softmax_i(query[:, q] . z_i[:, t] / sqrt(n_embd)) z_i[:, t]
     // query: [n_embd, n_query], cur and each block: [n_embd, n_tokens] with contiguous rows, n_blocks <= 8
+    // the result is a view: each token column also holds 45 partial sums per 256-element slice
     GGML_API struct ggml_tensor * ggml_inkling_mix(
             struct ggml_context * ctx,
             struct ggml_tensor  * query,
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index f4f7b6f37..fb2658a84 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -11571,9 +11571,10 @@ void ggml_compute_forward_inkling_mix(
     const int n_blocks = ggml_get_op_params_i32(dst, 0);
     const int n_states = n_blocks + 1;
 
-    const int64_t n_embd   = dst->ne[0];
-    const int64_t n_query  = dst->ne[1];
-    const int64_t n_tokens = dst->ne[2];
+    const int64_t n_embd   = query->ne[0];
+    const int64_t n_query  = query->ne[1];
+    const int64_t n_tokens = dst->ne[1];
+    const int64_t n_slices = (n_embd + 255)/256;
 
     // state i: the blocks in order, then cur
     const ggml_tensor * states[GGML_MAX_SRC];
@@ -11582,27 +11583,43 @@ void ggml_compute_forward_inkling_mix(
     }
     states[n_blocks] = dst->src[1];
 
-    std::vector<float> rinv(n_states), w(n_states);
+    float tot[45];
 
     for (int64_t t = params->ith; t < n_tokens; t += params->nth) {
+        float * col = (float *) ((char *) dst->data + t*dst->nb[1]);
+        float * scr = col + n_embd*n_query;
+
         const float * s[GGML_MAX_SRC];
         for (int i = 0; i < n_states; ++i) {
             s[i] = (const float *) ((const char *) states[i]->data + t*states[i]->nb[1]);
-            ggml_float ss = 0.0;
-            for (int64_t e = 0; e < n_embd; ++e) {
-                ss += (ggml_float) s[i][e]*s[i][e];
+        }
+
+        // k = i: sum of squares of state i; k = 9*(1 + q) + i: query q . state i; per slice of 256 elements
+        for (int k = 0; k < 45; ++k) {
+            tot[k] = 0.0f;
+        }
+        for (int64_t c = 0; c < n_slices; ++c) {
+            float part[45] = {};
+            for (int64_t e = c*256; e < std::min<int64_t>(n_embd, (c + 1)*256); ++e) {
+                for (int i = 0; i < n_states; ++i) {
+                    const float x = s[i][e];
+                    part[i] += x*x;
+                    for (int64_t q = 0; q < n_query; ++q) {
+                        part[9*(1 + q) + i] += ((const float *) ((const char *) query->data + q*query->nb[1]))[e]*x;
+                    }
+                }
+            }
+            for (int k = 0; k < 45; ++k) {
+                scr[c*45 + k] = part[k];
+                tot[k] += part[k];
             }
-            rinv[i] = 1.0f/sqrtf((float) (ss/n_embd) + 1e-6f);
         }
+
+        float w[9];
         for (int64_t q = 0; q < n_query; ++q) {
-            const float * qv = (const float *) ((const char *) query->data + q*query->nb[1]);
             float mx = -INFINITY;
             for (int i = 0; i < n_states; ++i) {
-                float dot = 0.0f;
-                for (int64_t e = 0; e < n_embd; ++e) {
-                    dot += qv[e]*s[i][e];
-                }
-                w[i] = dot*rinv[i]/sqrtf((float) n_embd);
+                w[i] = tot[9*(1 + q) + i]/sqrtf(tot[i]/n_embd + 1e-6f)/sqrtf((float) n_embd);
                 mx = std::max(mx, w[i]);
             }
             float sum = 0.0f;
@@ -11610,13 +11627,15 @@ void ggml_compute_forward_inkling_mix(
                 w[i] = expf(w[i] - mx);
                 sum += w[i];
             }
-            float * o = (float *) ((char *) dst->data + q*dst->nb[1] + t*dst->nb[2]);
+            for (int i = 0; i < n_states; ++i) {
+                w[i] = w[i]/sum/sqrtf(tot[i]/n_embd + 1e-6f);
+            }
             for (int64_t e = 0; e < n_embd; ++e) {
                 float acc = 0.0f;
                 for (int i = 0; i < n_states; ++i) {
-                    acc += w[i]*rinv[i]*s[i][e];
+                    acc += w[i]*s[i][e];
                 }
-                o[e] = acc/sum;
+                col[q*n_embd + e] = acc;
             }
         }
     }
