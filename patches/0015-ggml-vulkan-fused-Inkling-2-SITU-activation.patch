diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/inkling_situ.comp b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_situ.comp
new file mode 100644
index 000000000..177912ced
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_situ.comp
@@ -0,0 +1,42 @@
+#version 450
+
+// Inkling 2 SITU activation of a fused gate/up row: k * tanh(g/beta)*sigmoid(g) * (lb > 0 ? tanh(u/lb) : u)
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_ff;
+    uint ne1;
+    uint ne2;
+    uint n_rows;
+    uint nba1;   // input strides, elements
+    uint nba2;
+    uint nba3;
+    uint a_offset;
+    uint d_offset;
+    float beta;
+    float lb;
+    float scale;
+};
+
+layout(binding = 0) readonly  buffer A { float data_a[]; };
+layout(binding = 1) writeonly buffer D { float data_d[]; };
+
+void main() {
+    const uint i   = gl_GlobalInvocationID.x;
+    const uint row = gl_GlobalInvocationID.y + gl_GlobalInvocationID.z*gl_NumWorkGroups.y;
+    if (i >= n_ff || row >= n_rows) {
+        return;
+    }
+    const uint i1 = row % ne1;
+    const uint i2 = (row / ne1) % ne2;
+    const uint i3 = row / (ne1*ne2);
+    const uint a_row = a_offset + i1*nba1 + i2*nba2 + i3*nba3;
+
+    const float g = data_a[a_row + i];
+    const float u = data_a[a_row + n_ff + i];
+    const float act = tanh(g/beta)/(1.0 + exp(-g));
+    const float up  = lb > 0.0 ? tanh(u/lb) : u;
+    data_d[d_offset + row*n_ff + i] = scale*act*up;
+}
