@@ -14053,6 +14094,10 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
     case GGML_OP_INKLING_CONV:
         ggml_vk_inkling_conv(ctx, compute_ctx, node);
 
+        break;
+    case GGML_OP_INKLING_PROJ:
