diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/inkling_tag_mask.comp b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_tag_mask.comp
new file mode 100644
index 000000000..be2d127e6
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/inkling_tag_mask.comp
@@ -0,0 +1,45 @@
+#version 450
+
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+// Inkling 2 attention mask shared by all heads, with the keys inside the relative-position extent tagged:
+// a visible key at distance d < n_extent holds 1 + d, every other key keeps its mask value (0 or -inf).
+// Flash attention then reads the bias of each head at that distance from a table (ggml_flash_attn_ext_set_rel_bias)
+// and no mask per head is built.
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_kv;
+    uint n_tps;     // tokens per stream
+    uint n_extent;
+    uint nbm1;      // mask strides, elements
+    uint nbm3;
+    uint nbd1;      // dst strides, elements
+    uint nbd3;
+    uint p_offset;
+    uint m_offset;
+    uint d_offset;
+};
+
+layout(binding = 0) readonly  buffer P { int       data_p[]; };
+layout(binding = 1) readonly  buffer M { float16_t data_m[]; };
+layout(binding = 2) writeonly buffer D { float16_t data_d[]; };
+
+void main() {
+    const uint kv = gl_GlobalInvocationID.x;
+    const uint tt = gl_WorkGroupID.y;
+    if (kv >= n_kv) {
+        return;
+    }
+    const uint s = tt / n_tps;
+    const uint t = tt % n_tps;
+
+    const int       dist = data_p[p_offset + n_kv*tt + kv];
+    const float16_t m    = data_m[m_offset + t*nbm1 + s*nbm3 + kv];
+
+    data_d[d_offset + t*nbd1 + s*nbd3 + kv] =
+        (float(m) == 0.0 && dist >= 0 && uint(dist) < n_extent) ? float16_t(float(dist + 1)) : m;
+}
