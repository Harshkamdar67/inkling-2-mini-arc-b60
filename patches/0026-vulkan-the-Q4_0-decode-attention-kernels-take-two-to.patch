+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_scores.comp
@@ -10,15 +10,15 @@
 // Flash attention for one query token over a long Q4_0 cache: the scores.
 // The cache codes are integers, so a key's dot product with a query quantized to 8 bits (fa_q4_query.comp)
 // is four multiply-adds per instruction; the 4-bit keys carry 16 times the rounding error the query adds.
-// Workgroup (block of KEYS keys, KV head): thread (key lane, query head) keeps its head's 32 query words
+// Workgroup (block of KEYS keys, KV head): thread (key lane, query slot) keeps its query's 32 words
 // and walks its keys, so nothing goes through shared memory until the block maximum at the end.
 
 layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
 
-const uint MAX_R = 4;      // query heads per KV head
+const uint MAX_Q = 8;      // query slots of a KV head: tokens x query heads per KV head
 const uint HS    = 128;
 const uint NB    = HS/32;
-const uint LANES = 256/MAX_R;
+const uint LANES = 256/MAX_Q;
 const float NEG  = -3.0e38;
 
 layout(constant_id = 0) const uint KEYS = 1024;   // keys per workgroup, a multiple of LANES
@@ -29,6 +29,10 @@ layout(push_constant) uniform parameter
     uint n_head_kv;
     uint r;
     uint nem2;
+    uint nbm1;       // mask strides, elements
+    uint nbm2;
