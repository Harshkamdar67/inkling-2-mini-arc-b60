diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
index eac69d2ca..b4b76691e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
@@ -8,23 +8,29 @@
 #extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
 
 // Flash attention over a long Q4_0 cache: the weighted values of one block of 256 keys.
-// Workgroup (key block, KV head). The weights exp(score - max) of the block go to shared memory first; a key
-// whose weight is below thr for every query head is skipped without reading its values.
+// Workgroup (key block, KV head), for the query slots of the KV head (slot = token*r + head).
+// The weights exp(score - max) of the block go to shared memory first; a key whose weight is below thr for
+// every slot is skipped without reading its values (with two streams in one cache, that is every key of the
+// other stream).
 // Thread (g, lane): g picks one 32-bit word of codes (8 dims: 4 low nibbles, 4 high ones) of one block of 32
-// dims, lane 16 of the keys. The codes are value + 8 and a block has one scale d, so per key and head the
+// dims, lane 32 of the keys. The codes are value + 8 and a block has one scale d, so per key and slot the
 // thread adds (w*d)*code for its 8 dims and keeps sum(w*d) once for the offset.
 
-layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
 
-const uint MAX_R = 4;
+const uint MAX_Q = 8;
 const uint HS    = 128;
 const uint NB    = HS/32;
+const uint LANES = 8;
+const uint KEYS  = 256;
 
 layout(push_constant) uniform parameter
 {
     uint n_kv;
     uint n_head_kv;
     uint r;
+    uint n_tok;
+    uint n_head_q;
     uint s_stride;
     uint n_wg;
     uint off_mg;
@@ -40,39 +46,46 @@ struct block_q4 {
 layout(binding = 0) readonly buffer V { block_q4 data_v[]; };
 layout(binding = 1)          buffer T { float    data_t[]; };
 
-shared float w[MAX_R][256];
-shared float wmax[256];
-shared vec4  part[16][MAX_R][16][2];   // [lane][head][g][low, high]
+shared float w[MAX_Q][KEYS];
+shared float wmax[KEYS];
+shared vec4  part[LANES][MAX_Q][16][2];   // [lane][slot][g][low, high]
+
+// the query of a slot of this KV head: token*n_head_q + head
+uint query(const uint hk, const uint slot) {
