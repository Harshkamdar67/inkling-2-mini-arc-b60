     uint m_offset;
     uint s_stride;   // scores per head (n_kv padded to KEYS)
     uint n_wg;
@@ -53,15 +57,17 @@ void main() {
     const uint tid  = gl_LocalInvocationID.x;
     const uint wg   = gl_WorkGroupID.x;
     const uint hk   = gl_WorkGroupID.y;
-    const uint h    = tid % MAX_R;
-    const uint lane = tid / MAX_R;
-    const uint hq   = hk*r + h;
+    const uint slot = tid % MAX_Q;
+    const uint lane = tid / MAX_Q;
+    const uint t    = slot / r;
+    const uint hq   = hk*r + slot % r;
+    const uint gq   = t*n_head_q + hq;
 
     float mx = NEG;
 
-    if (h < r) {
