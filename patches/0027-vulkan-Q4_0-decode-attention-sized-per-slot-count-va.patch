From d3fd211ad5f9ff0e782c1eedb4ae28e43dab35bb Mon Sep 17 00:00:00 2001
From: Harshkamdar67 <harshkamdar67@gmail.com>
Date: Sun, 22 Nov 2026 21:35:57 +0530
Subject: [PATCH 27/32] vulkan: Q4_0 decode attention sized per slot count,
 values without cross-thread sums

---
 ggml/src/ggml-vulkan/ggml-vulkan-types.h      |   1 +
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          |  17 ++-
 .../vulkan-shaders/fa_q4_scores.comp          |  11 +-
 .../vulkan-shaders/fa_q4_values.comp          | 116 ++++++++----------
 .../vulkan-shaders/vulkan-shaders-gen.cpp     |   2 +
 5 files changed, 78 insertions(+), 69 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-types.h b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
index 085f0cf2b..3726047ee 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-types.h
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
@@ -1006,6 +1006,7 @@ struct vk_device_struct {
     vk_pipeline pipeline_inkling_tag_mask_f16;
     // one query token over a long Q4_0 cache: query, scores, max, weighted values, reduce (fa_q4_*.comp)
     vk_pipeline pipeline_fa_q4[5];
+    vk_pipeline pipeline_fa_q4_wide[2];   // scores and values for 8 query slots (two tokens a step)
     vk_pipeline pipeline_dsv4_hc_post_nocomb_f32;
     vk_pipeline pipeline_top_k_mask_f16;
     vk_pipeline pipeline_top_k_mask_f32;
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 0b50a810f..30fa4c82a 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4097,7 +4097,10 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     if (device->integer_dot_product && device->subgroup_arithmetic && device->subgroup_require_full_support) {
         const uint32_t fa_q4_keys = 1024; // keys per scores workgroup
         ggml_vk_create_pipeline(device, device->pipeline_fa_q4[0], "fa_q4_query", fa_q4_query_len, fa_q4_query_data, "main", 2, sizeof(vk_fa_q4_query_push_constants), {1, 1, 1}, {}, 1);
+        // slot counts 4 (one token) and 8 (two tokens) as separate pipelines: sized for 8, a one-token step leaves 5 of 8 threads idle
         ggml_vk_create_pipeline(device, device->pipeline_fa_q4[1], "fa_q4_scores", fa_q4_scores_len, fa_q4_scores_data, "main", 3, sizeof(vk_fa_q4_scores_push_constants), {fa_q4_keys, 1, 1}, {fa_q4_keys}, 1);
+        ggml_vk_create_pipeline(device, device->pipeline_fa_q4_wide[0], "fa_q4_scores_8", fa_q4_scores_8_len, fa_q4_scores_8_data, "main", 3, sizeof(vk_fa_q4_scores_push_constants), {fa_q4_keys, 1, 1}, {fa_q4_keys}, 1);
+        ggml_vk_create_pipeline(device, device->pipeline_fa_q4_wide[1], "fa_q4_values_8", fa_q4_values_8_len, fa_q4_values_8_data, "main", 2, sizeof(vk_fa_q4_values_push_constants), {256, 1, 1}, {}, 1);
         ggml_vk_create_pipeline(device, device->pipeline_fa_q4[2], "fa_q4_max", fa_q4_max_len, fa_q4_max_data, "main", 1, sizeof(vk_fa_q4_max_push_constants), {1, 1, 1}, {}, 1, false, true);
         ggml_vk_create_pipeline(device, device->pipeline_fa_q4[3], "fa_q4_values", fa_q4_values_len, fa_q4_values_data, "main", 2, sizeof(vk_fa_q4_values_push_constants), {256, 1, 1}, {}, 1);
         ggml_vk_create_pipeline(device, device->pipeline_fa_q4[4], "fa_q4_reduce", fa_q4_reduce_len, fa_q4_reduce_data, "main", 3, sizeof(vk_fa_q4_reduce_push_constants), {1, 1, 1}, {}, 1);
@@ -9344,10 +9347,10 @@ static bool ggml_vk_flash_attn_q4_decode(ggml_backend_vk_context * ctx, vk_conte
     }
 
     // scratch, in floats: the scores of each query head, the maximum of each scores workgroup, the maximum of each
-    // head, the quantized queries (40 values a head), then per head and values workgroup 128 sums and their weight
+    // head, the quantized queries (40 values a head), then per query and half of a values workgroup 128 sums and their weight
     const uint32_t keys     = ctx->device->pipeline_fa_q4[1]->wg_denoms[0];
     const uint32_t n_wg_s   = (uint32_t) CEIL_DIV(n_kv, keys);
-    const uint32_t n_wg_v   = (uint32_t) CEIL_DIV(n_kv, 256);
+    const uint32_t n_wg_v   = 2*(uint32_t) CEIL_DIV(n_kv, 256);   // rows of partial sums: two halves per values workgroup
     const uint32_t s_stride = n_wg_s*keys;
     const uint32_t off_mx   = (uint32_t) n_q*s_stride;
     const uint32_t off_mg   = off_mx + (uint32_t) n_q*n_wg_s;
@@ -9363,7 +9366,15 @@ static bool ggml_vk_flash_attn_q4_decode(ggml_backend_vk_context * ctx, vk_conte
         return false;
     }
 
-    vk_pipeline * pl = ctx->device->pipeline_fa_q4;
+    const bool wide = n_tok*r > 4;
+    vk_pipeline pl[5];
+    for (int i = 0; i < 5; ++i) {
+        pl[i] = ctx->device->pipeline_fa_q4[i];
+    }
+    if (wide) {
+        pl[1] = ctx->device->pipeline_fa_q4_wide[0];
+        pl[3] = ctx->device->pipeline_fa_q4_wide[1];
+    }
     for (int i = 0; i < 5; ++i) {
         ggml_pipeline_request_descriptor_sets(ctx, pl[i], 1);
     }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_scores.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_scores.comp
index 8f22f2ec6..26ba20135 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_scores.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_scores.comp
@@ -15,13 +15,16 @@
 
 layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
 
-const uint MAX_Q = 8;      // query slots of a KV head: tokens x query heads per KV head
 const uint HS    = 128;
 const uint NB    = HS/32;
-const uint LANES = 256/MAX_Q;
 const float NEG  = -3.0e38;
 
-layout(constant_id = 0) const uint KEYS = 1024;   // keys per workgroup, a multiple of LANES
+layout(constant_id = 0) const uint KEYS  = 1024;  // keys per workgroup, a multiple of LANES
+// query slots of a KV head (tokens x query heads per KV head): 4, or 8 in the two-token variant
+#ifndef FA_Q4_SLOTS
+#define FA_Q4_SLOTS 4
+#endif
+const uint MAX_Q = FA_Q4_SLOTS;
 
 layout(push_constant) uniform parameter
 {
@@ -51,6 +54,8 @@ layout(binding = 1) readonly buffer M  { float16_t data_m[]; };
 layout(binding = 2)          buffer T  { float     data_t[]; };
 layout(binding = 2)          buffer TI { int32_t   data_ti[]; };
 
+const uint LANES = 256/MAX_Q;
+
 shared float red[256];
 
 void main() {
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
index b4b76691e..99e3b1dd5 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fa_q4_values.comp
@@ -7,22 +7,26 @@
 #extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
 #extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
 
-// Flash attention over a long Q4_0 cache: the weighted values of one block of 256 keys.
-// Workgroup (key block, KV head), for the query slots of the KV head (slot = token*r + head).
-// The weights exp(score - max) of the block go to shared memory first; a key whose weight is below thr for
-// every slot is skipped without reading its values (with two streams in one cache, that is every key of the
-// other stream).
-// Thread (g, lane): g picks one 32-bit word of codes (8 dims: 4 low nibbles, 4 high ones) of one block of 32
-// dims, lane 32 of the keys. The codes are value + 8 and a block has one scale d, so per key and slot the
-// thread adds (w*d)*code for its 8 dims and keeps sum(w*d) once for the offset.
-
-layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
-
-const uint MAX_Q = 8;
-const uint HS    = 128;
-const uint NB    = HS/32;
-const uint LANES = 8;
-const uint KEYS  = 256;
+// Flash attention over a long Q4_0 cache: the weighted values.
+// Workgroup (256 keys, KV head), for the query slots of the KV head (slot = token*r + head), in two halves of
+// 128 keys that each write one row of partial sums. The weights exp(score - max) of the keys go to shared
+// memory first; a key whose weight is below thr for every slot is skipped without reading its values (with two
+// streams in one cache, that is every key of the other stream).
+// Thread (half, g): g picks one 32-bit word of codes (8 dims: 4 low nibbles, 4 high ones) of one block of 32
+// dims and walks the 128 keys of its half, so no sum crosses threads. The codes are value + 8 and a block has
+// one scale d: per key and slot the thread adds (w*d)*code for its 8 dims and keeps sum(w*d) for the offset.
+
+#ifndef FA_Q4_SLOTS
+#define FA_Q4_SLOTS 4
+#endif
+const uint MAX_Q = FA_Q4_SLOTS;
+
+layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
+
+const uint HS   = 128;
+const uint NB   = HS/32;
+const uint KEYS = 256;
+const uint HALF = KEYS/2;
 
 layout(push_constant) uniform parameter
 {
@@ -32,7 +36,7 @@ layout(push_constant) uniform parameter
     uint n_tok;
     uint n_head_q;
     uint s_stride;
-    uint n_wg;
+    uint n_part;     // rows of partial sums per query: two per workgroup
     uint off_mg;
     uint off_p;
     float thr;
@@ -48,12 +52,6 @@ layout(binding = 1)          buffer T { float    data_t[]; };
 
 shared float w[MAX_Q][KEYS];
 shared float wmax[KEYS];
-shared vec4  part[LANES][MAX_Q][16][2];   // [lane][slot][g][low, high]
-
-// the query of a slot of this KV head: token*n_head_q + head
-uint query(const uint hk, const uint slot) {
-    return (slot / r)*n_head_q + hk*r + slot % r;
-}
 
 void main() {
     const uint tid    = gl_LocalInvocationID.x;
@@ -61,15 +59,19 @@ void main() {
     const uint hk     = gl_WorkGroupID.y;
     const uint n_slot = n_tok*r;
 
-    [[unroll]] for (uint it = 0; it < KEYS/128; ++it) {
-        const uint kl  = tid + 128*it;
+    // the queries of the slots (token*n_head_q + head), once: the divisions are not for the loops below
+    uint gqs[MAX_Q];
+    [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
+        gqs[s] = (s / r)*n_head_q + hk*r + s % r;
+    }
+
+    for (uint kl = tid; kl < KEYS; kl += 32) {
         const uint key = wg*KEYS + kl;
         float m = 0.0;
         [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
             float x = 0.0;
             if (s < n_slot && key < n_kv) {
-                const uint gq = query(hk, s);
-                x = exp(data_t[gq*s_stride + key] - data_t[off_mg + gq]);
+                x = exp(data_t[gqs[s]*s_stride + key] - data_t[off_mg + gqs[s]]);
                 x = x < thr ? 0.0 : x;
             }
             w[s][kl] = x;
@@ -79,31 +81,24 @@ void main() {
     }
     barrier();
 
-    // the sum of the weights of each query rides after its HS values
-    if (tid < n_slot) {
-        float l = 0.0;
-        for (uint i = 0; i < KEYS; ++i) {
-            l += w[tid][i];
-        }
-        data_t[off_p + (query(hk, tid)*n_wg + wg)*(HS + 1) + HS] = l;
-    }
-
+    const uint hf   = tid / 16;
     const uint g    = tid % 16;
-    const uint lane = tid / 16;
     const uint b    = g / 4;
     const uint j    = g % 4;
 
     vec4  lo[MAX_Q];
     vec4  hi[MAX_Q];
     float off[MAX_Q];
+    float l[MAX_Q];
     [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
         lo[s]  = vec4(0.0);
         hi[s]  = vec4(0.0);
         off[s] = 0.0;
+        l[s]   = 0.0;
     }
 
-    for (uint i = 0; i < KEYS/LANES; ++i) {
-        const uint kl = lane*(KEYS/LANES) + i;
+    for (uint i = 0; i < HALF; ++i) {
+        const uint kl = hf*HALF + i;
         if (wmax[kl] != 0.0) {
             const uint  ib = ((wg*KEYS + kl)*n_head_kv + hk)*NB + b;
             const float d  = float(data_v[ib].d);
@@ -111,34 +106,29 @@ void main() {
             const vec4  cl = vec4(unpack8(c & 0x0F0F0F0Fu));
             const vec4  ch = vec4(unpack8((c >> 4) & 0x0F0F0F0Fu));
             [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
-                if (s < n_slot) {
-                    const float wd = w[s][kl]*d;
-                    lo[s]  += wd*cl;
-                    hi[s]  += wd*ch;
-                    off[s] += wd;
-                }
+                const float ws = w[s][kl];
+                const float wd = ws*d;
+                lo[s]  += wd*cl;
+                hi[s]  += wd*ch;
+                off[s] += wd;
+                l[s]   += ws;
             }
         }
     }
-    [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
-        part[lane][s][g][0] = lo[s] - 8.0*off[s];
-        part[lane][s][g][1] = hi[s] - 8.0*off[s];
-    }
-    barrier();
 
-    // thread (g, slot): add the lanes and write the 8 dims of the word
-    if (lane < n_slot) {
-        const uint s = lane;
-        vec4 sl = vec4(0.0);
-        vec4 sh = vec4(0.0);
-        [[unroll]] for (uint i = 0; i < LANES; ++i) {
-            sl += part[i][s][g][0];
-            sh += part[i][s][g][1];
-        }
-        const uint base = off_p + (query(hk, s)*n_wg + wg)*(HS + 1) + b*32 + 4*j;
-        [[unroll]] for (uint e = 0; e < 4; ++e) {
-            data_t[base + e]      = sl[e];
-            data_t[base + 16 + e] = sh[e];
+    [[unroll]] for (uint s = 0; s < MAX_Q; ++s) {
+        if (s < n_slot) {
+            const uint p = off_p + (gqs[s]*n_part + wg*2 + hf)*(HS + 1);
+            const vec4 sl = lo[s] - 8.0*off[s];
+            const vec4 sh = hi[s] - 8.0*off[s];
+            [[unroll]] for (uint e = 0; e < 4; ++e) {
+                data_t[p + b*32 + 4*j + e]      = sl[e];
+                data_t[p + b*32 + 4*j + 16 + e] = sh[e];
+            }
+            // the sum of the weights of the half rides after its HS values
+            if (g == 0) {
+                data_t[p + HS] = l[s];
+            }
         }
     }
 }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index 8d7278196..f315a75d7 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -1096,6 +1096,8 @@ void process_shaders() {
 #if defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
     string_to_spv("fa_q4_query", "fa_q4_query.comp", {});
     string_to_spv("fa_q4_scores", "fa_q4_scores.comp", {});
+    string_to_spv("fa_q4_scores_8", "fa_q4_scores.comp", {{"FA_Q4_SLOTS", "8"}});
+    string_to_spv("fa_q4_values_8", "fa_q4_values.comp", {{"FA_Q4_SLOTS", "8"}});
     string_to_spv("fa_q4_max", "fa_q4_max.comp", {});
     string_to_spv("fa_q4_values", "fa_q4_values.comp", {});
     string_to_spv("fa_q4_reduce", "fa_q4_reduce.comp", {});
