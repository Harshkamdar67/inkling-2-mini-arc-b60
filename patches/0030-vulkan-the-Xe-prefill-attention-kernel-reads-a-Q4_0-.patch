+                    if (v_key < p.nek1) {
+                        vals = q4_chunk_v(v_key, head_v_idx, p.nev2, dim0 / 8);
+                    }
+                    const uint base = vsh_offset + TM * r * TK * v_hori_groups + lane_c;
+                    [[unroll]] for (uint i = 0; i < 4; ++i) {
+                        F16Poolsh.F16sh[base + i * TK]       = vals[0][i];
+                        F16Poolsh.F16sh[base + (4 + i) * TK] = vals[1][i];
+                    }
+                }
+            }
+        } else if (v_in_shmem && (qk_sg == sg_count || sg >= sg_count - loadv_sg)) {
             if (seq_boundary_check && loop + 1 == loop_count) {
                 const uint v_global_coord_base = loop * step_p + sg_v_c * TK + lane_c;
                 if (v_boundary_check) {
