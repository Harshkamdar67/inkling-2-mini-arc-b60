 const bool aligned_q_stride = (Flags & UNALIGNED_Q_STRIDE_BIT) == 0;
 const bool seq_boundary_check = (Flags & UNALIGNED_SEQ_LEN_BIT) != 0;
+const bool kv_q4 = (Flags & KV_Q4_BIT) != 0;
 const bool partial_row_mask = (Flags & PARTIAL_ROW_MASK_BIT) != 0;
 const uint TK = 16;
 const uint sg_count = WorkGroupSize / SubGroupSize;
@@ -157,6 +168,24 @@ shared shf16m2x4_alias {
     f16mat2x4 M2x4sh[shmem_size / 16];
 } F16M2x4Poolsh;
 
+// 8 consecutive dims (chunk c of a head's dims) of one key of a Q4_0 cache, as the kernel stages them in F16.
+// A block is 32 dims: its first 16 are the low nibbles of the 16 code bytes, the next 16 the high nibbles.
+#define Q4_CHUNK(NAME, DATA) \
+f16mat2x4 NAME(const uint key, const uint head, const uint n_head, const uint c) { \
+    const uint  ib   = (key * n_head + head) * (HSK / 32) + c / 4; \
+    const uint  part = c % 4; \
+    const uint  w    = (part & 1u) * 4; \
+    const uint  sh   = part >= 2 ? 4u : 0u; \
+    const float d    = float(DATA[ib].d); \
+    const uint  w0   = uint(DATA[ib].qs[w]) | (uint(DATA[ib].qs[w + 1]) << 16); \
+    const uint  w1   = uint(DATA[ib].qs[w + 2]) | (uint(DATA[ib].qs[w + 3]) << 16); \
+    const vec4  a    = (vec4(unpack8((w0 >> sh) & 0x0F0F0F0Fu)) - 8.0f) * d; \
+    const vec4  b    = (vec4(unpack8((w1 >> sh) & 0x0F0F0F0Fu)) - 8.0f) * d; \
+    return f16mat2x4(f16vec4(a), f16vec4(b)); \
+}
+Q4_CHUNK(q4_chunk_k, data_kq4)
+Q4_CHUNK(q4_chunk_v, data_vq4)
+
 void main() {
     const uint lane = gl_SubgroupInvocationID;
     const uint lane_c = lane % TN;
@@ -367,6 +396,10 @@ void main() {
                     if (mask_load_k[idx]) {
                         if (k_col == 4) {
                             F16V4Poolsh.F16V4sh[ksh_offset[idx]] = data_kv4[k_offset[idx]];
+                        } else if (kv_q4) {
