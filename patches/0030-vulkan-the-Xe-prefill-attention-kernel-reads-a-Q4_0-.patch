+struct block_q4 {
+    float16_t d;
+    uint16_t  qs[8];
+};
+layout (binding = 1) readonly buffer KQ4 {block_q4 data_kq4[];};
+layout (binding = 2) readonly buffer VQ4 {block_q4 data_vq4[];};
 // relative-position bias [rel_dist, n_head_q, n_tokens], read where the mask holds 1 + distance (REL_BIAS_BIT)
 layout (binding = 6) readonly buffer RB {float data_rb[];};
 
@@ -75,12 +84,14 @@ layout (constant_id = 14) const uint gqa_fold = 1;
 #define UNALIGNED_Q_STRIDE_BIT (1 << 1)
 #define PARTIAL_ROW_MASK_BIT (1 << 2)
 #define INTEL_GPU_BIT (1 << 3)
+#define KV_Q4_BIT (1 << 4)
 #define SINK_ENABLE_BIT (1 << 16)
