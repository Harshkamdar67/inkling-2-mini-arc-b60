+                            F16M2x4Poolsh.M2x4sh[ksh_offset[idx]] =
+                                q4_chunk_k(min(loop * step_p + kpos / (HSK / k_col), p.nek1 - 1), head_k_idx, p.nek2, kpos % (HSK / k_col));
                         } else {
                             F16M2x4Poolsh.M2x4sh[ksh_offset[idx]] = data_km2x4[k_offset[idx]];
                         }
@@ -381,6 +414,10 @@ void main() {
 
                     if (k_col == 4) {
                         F16V4Poolsh.F16V4sh[ksh_offset[idx]] = data_kv4[k_offset[idx]];
+                    } else if (kv_q4) {
+                        const uint kpos = idx * WorkGroupSize + sg * SubGroupSize + lane;
+                        F16M2x4Poolsh.M2x4sh[ksh_offset[idx]] =
+                            q4_chunk_k(min(loop * step_p + kpos / (HSK / k_col), p.nek1 - 1), head_k_idx, p.nek2, kpos % (HSK / k_col));
                     } else {
                         F16M2x4Poolsh.M2x4sh[ksh_offset[idx]] = data_km2x4[k_offset[idx]];
                     }
@@ -607,7 +644,24 @@ void main() {
             Mf = Mnewf;
         }
 
-        if (v_in_shmem && (qk_sg == sg_count || sg >= sg_count - loadv_sg)) {
+        if (kv_q4 && v_in_shmem && (qk_sg == sg_count || sg >= sg_count - loadv_sg)) {
+            // one lane per key of the group (SubGroupSize == TK): its 8 dims of each row block, decoded in place
+            const uint v_key = loop * step_p + sg_v_c * TK + lane_c;
+            [[unroll]] for (uint r = 0; r < v_loops; ++r) {
+                const uint dim0 = TM * (sg_v_r + r * v_hori_groups);
+                if (dim0 < HSV) {
